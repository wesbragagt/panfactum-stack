#!/usr/bin/env python3
"""Set up kubectl access to Talos through VPN, SSM or public bootstrap.

Subcommands: preflight (check tools, AWS identity and a tunnel host), forward
(tunnel the Talos port before the first apply), register (add a cluster's module and user entries after
its first apply), build (write cluster_info.talos from module outputs) and merge
(write the registered clusters into $KUBE_DIR/config).

$KUBE_DIR (default: .kube at the git repository root) holds three files. config.talos.yaml lists
the module paths. cluster_info.talos is committed and has no secrets: region, module path, CA and
endpoints per cluster, plus the cluster's iam_login metadata when its module outputs it.
config.talos.user.yaml is gitignored and records the operator's AWS profile and transport
per cluster. Both are read as JSON or,
for the user file, as a block list:

  - name: my-cluster
    aws_profile: my-profile
    transport: vpn
    iam_profile: my-iam-profile

Omitting transport selects VPN.

The kubeconfig user runs python3 on cluster_access.py (next to this script) with
--exec-credential to fetch the credential on demand, so config holds no keys.

An iam_profile adds a <name>-iam context for VPN clusters that output iam_login. Its user runs
iam_login.py credential with that AWS profile, so the context needs no tunnel helper or Talos
certificate. merge writes the metadata that script reads to $KUBE_DIR/<name>.iam.json.
"""

import argparse
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
import cluster_access  # noqa: E402

MODULES = "config.talos.yaml"
USER = "config.talos.user.yaml"
INFO = "cluster_info.talos"
DEFAULT_PORTS = {"kube_port": 16443, "talos_port": 50000}


class SetupError(Exception):
    pass


def kube_dir():
    if os.environ.get("KUBE_DIR"):
        return Path(os.environ["KUBE_DIR"]).resolve()
    # NOTE: Linked checkouts share the primary checkout's config with direnv.
    return repo_root(Path.cwd(), primary=True) / ".kube"


def repo_root(directory, *, primary=False):
    directory.mkdir(parents=True, exist_ok=True)
    query = ["--path-format=absolute", "--git-common-dir"] if primary else ["--show-toplevel"]
    result = subprocess.run(["git", "-C", str(directory), "rev-parse", *query],
                            capture_output=True, text=True)
    if result.returncode:
        raise SetupError(f"{directory} is not inside a git repository; "
                         "run from the repository or set KUBE_DIR to its .kube directory")
    path = Path(result.stdout.strip()).resolve()
    return path.parent if primary else path


def atomic_write(path, content):
    path.parent.mkdir(parents=True, exist_ok=True)
    # mkstemp creates the file with mode 0600 in the target directory.
    descriptor, temp = tempfile.mkstemp(dir=path.parent, prefix=".talos-")
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(content)
        os.replace(temp, path)
    except BaseException:
        if os.path.exists(temp):
            os.unlink(temp)
        raise


def dump(data):
    return (json.dumps(data, indent=2, sort_keys=True) + "\n").encode()


def read_committed(path):
    if not path.exists() or not path.read_text().strip():
        return {}
    try:
        clusters = json.loads(path.read_text())["clusters"]
        return {name: {**DEFAULT_PORTS, **entry} for name, entry in clusters.items()}
    except (ValueError, KeyError, TypeError, AttributeError) as exc:
        raise SetupError(f"{path} must be JSON with a top-level \"clusters\" object") from exc


def parse_block_list(text, path, keys):
    """Read a clusters list from JSON or a block list of the given keys."""
    try:
        data = json.loads(text) if text.strip() else []
    except ValueError:
        data = None
    if data is None:
        data, item = [], None
        for number, raw in enumerate(text.splitlines(), 1):
            line = raw.split(" #")[0].strip()
            if not line or line.startswith("#") or line in ("---", "clusters:"):
                continue
            if line.startswith("- "):
                item = {}
                data.append(item)
                line = line[2:].strip()
            key, sep, value = line.partition(":")
            if item is None or not sep or key.strip() not in keys:
                raise SetupError(f"{path}:{number}: expected one of {', '.join(keys)} as '- key: value'")
            item[key.strip()] = value.strip().strip("\"'")
    if isinstance(data, dict):
        data = data.get("clusters", [])
    return data


def parse_user(text, path):
    """Read the operator's profile and transport from JSON or a block list."""
    data = parse_block_list(text, path, ("name", "aws_profile", "transport", "iam_profile"))
    try:
        entries = {entry["name"]: entry for entry in data}
    except (KeyError, TypeError, AttributeError) as exc:
        raise SetupError(f"{path}: every entry needs a name") from exc
    for name, entry in entries.items():
        if entry.get("transport", "vpn") not in ("vpn", "ssm", "bootstrap_public"):
            raise SetupError(f"{path}: {name} transport must be vpn, ssm or bootstrap_public")
    return entries


def read_user(path):
    return parse_user(path.read_text(), path) if path.exists() else {}


def kubectl_config(path):
    if not path.exists():
        return {"apiVersion": "v1", "kind": "Config", "clusters": [], "contexts": [],
                "users": [], "current-context": "", "preferences": {}}
    config = json.loads(cluster_access.command(
        ["kubectl", "--kubeconfig", str(path), "config", "view", "--raw", "-o", "json"]))
    for key in ("clusters", "contexts", "users"):
        config[key] = config.get(key) or []
    return config


def upsert(items, entry):
    for index, item in enumerate(items):
        if item.get("name") == entry["name"]:
            items[index] = entry
            return
    items.append(entry)


def recovery_exists(config, name, recovery, *, require_available=False):
    matching = {key: next((item for item in (config.get(key) or []) if item["name"] == recovery), None)
                for key in ("contexts", "clusters", "users")}
    if not any(matching.values()):
        return False
    context = (matching["contexts"] or {}).get("context", {})
    args = (matching["users"] or {}).get("user", {}).get("exec", {}).get("args", [])
    if (all(matching.values()) and context.get("cluster") == recovery and context.get("user") == recovery
            and len(args) >= 4 and Path(args[0]).name == "cluster_access.py"
            and args[1:4] == ["--exec-credential", "--cluster", name]):
        return True
    if require_available:
        raise SetupError(f"cannot create {recovery}: that name is already used in the kubeconfig")
    return False


def credential_helper(root, script="cluster_access.py"):
    helper = HERE / script
    # NOTE: A shared kubeconfig must outlive the linked checkout that generated it.
    try:
        shared = root / helper.relative_to(repo_root(HERE))
    except SetupError:
        return helper
    return shared if shared.is_file() else helper


def talos_endpoint_args(entry, transport, node=None):
    arguments = []
    if transport == "vpn":
        cluster_access.validate_private_endpoints(entry.get("kube_api_server"), entry.get("talos_endpoints"))
        for endpoint in entry["talos_endpoints"]:
            arguments += ["--talos-endpoint", endpoint]
        if hostname := entry.get("stable_api_hostname"):
            arguments += ["--talos-hostname", hostname]
    if transport == "bootstrap_public":
        cluster_access.validate_public_endpoint(entry.get("bootstrap_public_host"), entry.get("bootstrap_public_node"))
        arguments += ["--bootstrap-public-host", entry["bootstrap_public_host"]]
        node = node or entry["bootstrap_public_node"]
    if node is not None:
        arguments += ["--node", node]
    return arguments


def cmd_build(_args):
    directory = kube_dir()
    root = repo_root(directory)
    modules = directory / MODULES
    try:
        listed = parse_block_list(modules.read_text() if modules.exists() else "", modules, ("module",))
        paths = [entry["module"] for entry in listed]
    except (KeyError, TypeError) as exc:
        raise SetupError(f"{modules}: every entry needs a module") from exc
    clusters = {}
    with tempfile.TemporaryDirectory(prefix="pf-bootstrap-talos-") as scratch:
        download = str(Path(scratch) / "terragrunt-download")
        env = dict(os.environ, TERRAGRUNT_DOWNLOAD=download, TG_DOWNLOAD_DIR=download)
        for relative in paths:
            module = root / "environments" / relative
            if not module.is_dir():
                raise SetupError(f"{modules}: {module} is not a directory")
            outputs = {key: value["value"] for key, value in json.loads(cluster_access.command(
                ["terragrunt", "output", "-json"], cwd=module, env=env, timeout=300)).items()}
            try:
                name = outputs["cluster_name"]
                entry = {"region": outputs["cluster_region"], "kube_api_server": outputs["cluster_url"],
                         "ca_data": outputs["cluster_ca_data"],
                         "talos_endpoints": outputs["control_plane_private_ips"],
                         "module": str(module.relative_to(root))}
            except KeyError as exc:
                raise SetupError(f"{relative}: module has no {exc.args[0]} output") from exc
            for key in ("stable_api_hostname", "bootstrap_public_host", "bootstrap_public_node", "iam_login"):
                if outputs.get(key):
                    entry[key] = outputs[key]
            cluster_access.validate_private_endpoints(entry["kube_api_server"], entry["talos_endpoints"])
            clusters[name] = entry
    atomic_write(directory / INFO, dump({"clusters": clusters}))
    return 0


def cmd_talosconfig(args):
    directory = kube_dir()
    config = kubectl_config(directory / "config")
    context = args.context or config.get("current-context", "")
    clusters = read_committed(directory / INFO)
    operators = read_user(directory / USER)
    name = context
    recovery = name not in clusters and name.endswith("-ssm") and recovery_exists(config, name[:-4], name)
    if recovery:
        name = name[:-4]
    if name not in clusters or name not in operators:
        raise SetupError(f"{context or 'current Kubernetes context'} has no configured Talos access")
    entry = clusters[name]
    operator = operators[name]
    transport = "ssm" if recovery else operator.get("transport", "vpn")
    root = repo_root(directory)
    command = [sys.executable, str(HERE / "cluster_access.py"), "--talos-config",
               "--cluster", name, "--module", str((root / entry["module"]).resolve()),
               "--region", entry["region"], "--talos-port", str(entry["talos_port"]), "--transport", transport]
    if profile := operator.get("aws_profile"):
        command += ["--profile", profile]
    os.execv(sys.executable, [*command, *talos_endpoint_args(entry, transport)])


def merge_iam_context(config, directory, root, name, entry, operator, clusters):
    """Add the <name>-iam context that signs in with the operator's IAM profile."""
    context = name + "-iam"
    if operator.get("transport", "vpn") != "vpn":
        print(f"pf-bootstrap-talos: {name} uses transport {operator['transport']}; "
              f"{context} supports only vpn, so it was skipped", file=sys.stderr)
        return
    if not entry.get("iam_login"):
        print(f"pf-bootstrap-talos: {name} has no iam_login metadata in {INFO}; "
              f"run pf-update-kube-talos --build to add {context}", file=sys.stderr)
        return
    if context in clusters:
        raise SetupError(f"cannot create {context}: it is already registered as a source cluster")
    metadata = directory / f"{name}.iam.json"
    content = dump(entry["iam_login"])
    if not metadata.exists() or metadata.read_bytes() != content:
        atomic_write(metadata, content)
    upsert(config["clusters"], {"name": context, "cluster": {
        "server": entry["kube_api_server"], "certificate-authority-data": entry["ca_data"]}})
    upsert(config["users"], {"name": context, "user": {"exec": {
        "apiVersion": "client.authentication.k8s.io/v1", "command": "python3",
        "args": [str(credential_helper(root, "iam_login.py")), "credential", "--config", str(metadata),
                 "--profile", operator["iam_profile"], "--aws-cli", "aws"],
        "interactiveMode": "Never"}}})
    upsert(config["contexts"], {"name": context, "context": {"cluster": context, "user": context}})


def cmd_merge(_args):
    directory = kube_dir()
    clusters = read_committed(directory / INFO)
    operators = read_user(directory / USER)
    if not clusters:
        return 0
    root = repo_root(directory)
    helper = credential_helper(root)
    path = directory / "config"
    current = kubectl_config(path)
    config = json.loads(json.dumps(current))
    for name, entry in sorted(clusters.items()):
        if name not in operators:
            print(f"pf-bootstrap-talos: {name} is not in {directory / USER}; "
                  f"add '- name: {name}' and 'aws_profile: <profile>' to use it", file=sys.stderr)
            continue
        exec_args = [str(helper), "--exec-credential", "--cluster", name]
        operator = operators[name]
        if operator.get("aws_profile"):
            exec_args += ["--profile", operator["aws_profile"]]
        exec_args += ["--region", entry["region"], "--kube-port", str(entry["kube_port"]),
                      "--talos-port", str(entry["talos_port"]),
                      "--module", str((root / entry["module"]).resolve())]
        address, _identity = cluster_access.client_endpoint("ssm", None, 6443, entry["kube_port"])
        loopback = f"https://{address}"
        contexts = [(name, loopback, exec_args)]
        recovery = name + "-ssm"
        if operator.get("transport", "vpn") == "vpn":
            cluster_access.validate_private_endpoints(entry.get("kube_api_server"), entry.get("talos_endpoints"))
            if recovery in clusters:
                raise SetupError(f"cannot create {recovery}: it is already registered as a source cluster")
            recovery_exists(config, name, recovery, require_available=True)
            contexts = [(name, entry["kube_api_server"], [*exec_args, "--transport", "vpn"]),
                        (recovery, loopback, exec_args)]
        elif operator.get("transport") == "bootstrap_public":
            host = entry.get("bootstrap_public_host")
            cluster_access.validate_public_endpoint(host, entry.get("bootstrap_public_node"))
            address, _identity = cluster_access.client_endpoint("bootstrap_public", host, 6443, None)
            contexts = [(name, f"https://{address}", [*exec_args, "--transport", "bootstrap_public"])]
        elif "kube_api_server" in entry and recovery not in clusters and recovery_exists(config, name, recovery):
            contexts.append((recovery, loopback, exec_args))
        for context, server, arguments in contexts:
            upsert(config["clusters"], {"name": context, "cluster": {
                "server": server, "certificate-authority-data": entry["ca_data"]}})
            upsert(config["users"], {"name": context, "user": {"exec": {
                "apiVersion": "client.authentication.k8s.io/v1", "command": "python3",
                "args": arguments, "interactiveMode": "Never"}}})
            upsert(config["contexts"], {"name": context, "context": {"cluster": context, "user": context}})
        if operator.get("iam_profile"):
            merge_iam_context(config, directory, root, name, entry, operator, clusters)
    # Rewriting an unchanged file would retrigger direnv's watch_file.
    if config != current or not path.exists():
        atomic_write(path, dump(config))
    return 0


def append_user_entry(text, name, profile, transport=None):
    """Add an entry in the file's layout: a bare list stays bare, anything else uses `clusters:`."""
    lines = text.splitlines()
    bare = (not any(line.split("#")[0].strip() == "clusters:" for line in lines)
            and any(line.startswith("- ") for line in lines))
    pad = "" if bare else "  "
    if lines and not text.endswith("\n"):
        text += "\n"
    if not bare and not any(line.split("#")[0].strip() == "clusters:" for line in lines):
        text += "clusters:\n"
    text += f"{pad}- name: {name}\n"
    if profile:
        text += f"{pad}  aws_profile: {profile}\n"
    return text + (f"{pad}  transport: {transport}\n" if transport else "")


def append_module_entry(text, module):
    """Add `- module:` under `clusters:`, creating the key when the file has none."""
    if any(entry.get("module") == module for entry in parse_block_list(text, MODULES, ("module",))):
        return text
    if text and not text.endswith("\n"):
        text += "\n"
    if not any(line.split("#")[0].strip() == "clusters:" for line in text.splitlines()):
        text += "clusters:\n"
    return text + f"  - module: {module}\n"


def cmd_register(args):
    directory = kube_dir()
    root = repo_root(directory)
    module = args.module.resolve()
    try:
        relative = module.relative_to(root)
    except ValueError as exc:
        if os.environ.get("KUBE_DIR") or repo_root(module, primary=True) != root:
            raise SetupError(f"--module {module} is outside the repository {root}") from exc
        relative = module.relative_to(repo_root(module))
    if relative.parts[:1] != ("environments",):
        raise SetupError(f"--module {module} must be under {root / 'environments'}")
    modules_path = directory / MODULES
    text = modules_path.read_text() if modules_path.exists() else ""
    updated = append_module_entry(text, str(relative.relative_to("environments")))
    if updated != text:
        atomic_write(modules_path, updated.encode())
    user_path = directory / USER
    operators = read_user(user_path)
    if args.cluster not in operators:
        profile = args.profile or os.environ.get("AWS_PROFILE")
        text = user_path.read_text() if user_path.exists() else ""
        if text.lstrip().startswith(("{", "[")):
            data = json.loads(text)
            entries = data if isinstance(data, list) else data.setdefault("clusters", [])
            entry = {"name": args.cluster}
            if profile:
                entry["aws_profile"] = profile
            if args.bootstrap_public:
                entry["transport"] = "bootstrap_public"
            entries.append(entry)
            text = dump(data).decode()
        else:
            text = append_user_entry(text, args.cluster, profile, "bootstrap_public" if args.bootstrap_public else None)
        atomic_write(user_path, text.encode())
    print(f"pf-bootstrap-talos: run pf-update-kube-talos --build to add {args.cluster} to .kube/config")
    return 0


def cmd_forward(args):
    rest = args.rest[1:] if args.rest[:1] == ["--"] else args.rest
    os.execv(sys.executable, [sys.executable, str(HERE / "cluster_access.py"), "--bootstrap", *rest])


def cmd_preflight(args):
    command = [sys.executable, str(HERE / "cluster_access.py"), "--preflight", "--bootstrap",
               "--cluster", args.cluster]
    for flag, value in (("--profile", args.profile), ("--region", args.region), ("--fixed-ssm", args.fixed_ssm)):
        if value:
            command += [flag, value]
    os.execv(sys.executable, command)


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)
    pre = sub.add_parser("preflight", help="check tools, AWS identity and a tunnel host")
    pre.add_argument("--cluster", required=True)
    pre.add_argument("--profile")
    pre.add_argument("--region")
    pre.add_argument("--fixed-ssm", help="fixed document and host JSON (default: PF_TALOS_FIXED_SSM)")
    pre.set_defaults(run=cmd_preflight)
    fwd = sub.add_parser("forward", help="cluster_access.py --bootstrap with the remaining flags")
    fwd.add_argument("rest", nargs=argparse.REMAINDER)
    fwd.set_defaults(run=cmd_forward)
    reg = sub.add_parser("register", help="add a cluster's module and user entries after its first apply")
    reg.add_argument("--cluster", required=True)
    reg.add_argument("--module", type=Path, required=True)
    reg.add_argument("--region", required=True)
    reg.add_argument("--profile")
    reg.add_argument("--bootstrap-public", action="store_true",
                     help="set transport bootstrap_public on a new user entry")
    reg.set_defaults(run=cmd_register)
    bld = sub.add_parser("build", help="write $KUBE_DIR/cluster_info.talos from the module outputs")
    bld.set_defaults(run=cmd_build)
    mrg = sub.add_parser("merge", help="write registered clusters into $KUBE_DIR/config")
    mrg.set_defaults(run=cmd_merge)
    talos = sub.add_parser("talosconfig", help="print the protected Talos config path for a Kubernetes context")
    talos.add_argument("context", nargs="?", help="defaults to the current Kubernetes context")
    talos.set_defaults(run=cmd_talosconfig)
    args = parser.parse_args()
    try:
        return args.run(args)
    except (SetupError, cluster_access.AccessError, OSError, ValueError, KeyError, StopIteration,
            subprocess.SubprocessError) as exc:
        message = exc if isinstance(exc, (SetupError, cluster_access.AccessError)) else f"{type(exc).__name__}: {exc}"
        print(f"pf-bootstrap-talos: {message}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
