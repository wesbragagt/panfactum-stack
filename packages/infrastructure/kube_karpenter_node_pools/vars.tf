variable "cluster_endpoint" {
  description = "The URL of the API server of the eks cluster"
  type        = string
}

variable "cluster_ca_data" {
  description = "The B64 encoded CA data of the API server of the eks cluster"
  type        = string
}

variable "node_instance_profile" {
  description = "The instance profile to use for launched nodes"
  type        = string
}

variable "node_ebs_volume_size_gb" {
  description = "The size of the EBS volume in GiB to use for each node."
  type        = number
  default     = 40
}

variable "cluster_dns_service_ip" {
  description = "The IP address of the cluster's DNS service."
  type        = string
}

variable "monitoring_enabled" {
  description = "Whether to active monitoring has been added to the cluster"
  type        = bool
  default     = false
}

variable "node_labels" {
  description = "Labels to apply to nodes generated by Karpenter"
  type        = map(string)
  default     = {}
}

variable "node_vpc_id" {
  description = "The ID of the VPC to deploy Karpenter nodes into."
  type        = string
}

variable "node_subnets" {
  description = "List of subnet names to deploy Karpenter nodes into."
  type        = set(string)
}

variable "node_security_group_id" {
  description = "The id of the security group for nodes running in the EKS cluster"
  type        = string
}

variable "min_node_memory_mb" {
  description = "The minimum memory for any single provisioned node (in MB)"
  type        = number
  default     = 2500
}

variable "max_node_memory_mb" {
  description = "The maximum memory for any single provisioned node (in MB)"
  type        = number
  default     = 65536
}

variable "min_node_cpu" {
  description = "The minimum number of vCPUs for any single provisioned node"
  type        = number
  default     = 0 # To allow smaller instances
}

variable "max_node_cpu" {
  description = "The maximum number of vCPUs for any single provisioned node"
  type        = number
  default     = 32
}

variable "arm64_node_ami_name" {
  description = "The name of the AMI to use for the amd64 nodes that Karpenter creates."
  type        = string
  default     = "bottlerocket-aws-k8s-1.33-aarch64-v1.57.0-beaadc52"
}

variable "amd64_node_ami_name" {
  description = "The name of the AMI to use for the amd64 nodes that Karpenter creates."
  type        = string
  default     = "bottlerocket-aws-k8s-1.33-x86_64-v1.57.0-beaadc52"
}

variable "default_termination_grace_period" {
  description = "The default termination grace period for on-demand nodes."
  type        = string
  default     = "1h0m0s"
}

variable "budgets" {
  description = "Voluntary disruption budgets applied to every NodePool. Defaults to 10%; an empty list explicitly allows unbounded voluntary disruption. Budgets do not prevent expiration, interruption, or other forceful disruption."
  type = list(object({
    nodes    = string
    schedule = optional(string)
    duration = optional(string)
    reasons  = optional(list(string))
  }))
  default = [{ nodes = "10%" }]

  validation {
    condition = alltrue([for budget in var.budgets :
      can(regex("^([0-9]+|[0-9]+%)$", budget.nodes)) &&
      (endswith(budget.nodes, "%") ? try(tonumber(trimsuffix(budget.nodes, "%")) <= 100, false) : true)
    ])
    error_message = "Each budget's nodes must be a nonnegative integer or a percentage from 0% to 100%."
  }

  validation {
    condition = alltrue([for budget in var.budgets :
      (budget.schedule == null) == (budget.duration == null)
    ])
    error_message = "Specify schedule and duration together, or omit both."
  }

  validation {
    condition = alltrue([for budget in var.budgets :
      budget.reasons == null ? true : alltrue([for reason in budget.reasons : contains(["Empty", "Underutilized", "Drifted"], reason)])
    ])
    error_message = "Budget reasons must be Empty, Underutilized, or Drifted."
  }
}
