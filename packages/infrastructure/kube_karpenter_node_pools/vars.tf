variable "cluster_endpoint" {
  description = "The URL of the API server of the eks cluster"
  type        = string
}

variable "cluster_ca_data" {
  description = "The B64 encoded CA data of the API server of the eks cluster"
  type        = string
}

variable "node_instance_profile" {
  description = "The instance profile to use for launched nodes"
  type        = string
}

variable "node_ebs_volume_size_gb" {
  description = "The size of the EBS volume in GiB to use for each node."
  type        = number
  default     = 40
}

variable "cluster_dns_service_ip" {
  description = "The IP address of the cluster's DNS service."
  type        = string
}

variable "monitoring_enabled" {
  description = "Whether to active monitoring has been added to the cluster"
  type        = bool
  default     = false
}

variable "node_labels" {
  description = "Labels to apply to nodes generated by Karpenter"
  type        = map(string)
  default     = {}
}

variable "node_vpc_id" {
  description = "The ID of the VPC to deploy Karpenter nodes into."
  type        = string
}

variable "node_subnets" {
  description = "List of subnet names to deploy Karpenter nodes into."
  type        = set(string)
}

variable "node_security_group_id" {
  description = "The id of the security group for nodes running in the EKS cluster"
  type        = string
}

variable "min_node_memory_mb" {
  description = "The minimum memory for any single provisioned node (in MB)"
  type        = number
  default     = 2500
}

variable "max_node_memory_mb" {
  description = "The maximum memory for any single provisioned node (in MB)"
  type        = number
  default     = 65536
}

variable "min_node_cpu" {
  description = "The minimum number of vCPUs for any single provisioned node"
  type        = number
  default     = 0 # To allow smaller instances
}

variable "max_node_cpu" {
  description = "The maximum number of vCPUs for any single provisioned node"
  type        = number
  default     = 32
}

variable "arm64_node_ami_name" {
  description = "The name of the AMI to use for the amd64 nodes that Karpenter creates."
  type        = string
  default     = "bottlerocket-aws-k8s-1.33-aarch64-v1.57.0-beaadc52"
}

variable "amd64_node_ami_name" {
  description = "The name of the AMI to use for the amd64 nodes that Karpenter creates."
  type        = string
  default     = "bottlerocket-aws-k8s-1.33-x86_64-v1.57.0-beaadc52"
}

variable "default_termination_grace_period" {
  description = "The default termination grace period for on-demand nodes."
  type        = string
  default     = "1h0m0s"
}

variable "cluster_type" {
  description = "Existing EKS/Bottlerocket path or opt-in Talos Custom AMI path."
  type        = string
  default     = "eks"
  validation {
    condition     = contains(["eks", "talos"], var.cluster_type)
    error_message = "cluster_type must be eks or talos."
  }
}
variable "talos_ami_id" {
  description = "Immutable Talos AMI matching the worker config version and architecture."
  type        = string
  default     = null
}
variable "talos_worker_config" {
  description = "Complete worker-only Talos YAML. Never supply control-plane CA/private keys. Stored in EC2 user data and the NodeClass."
  type        = string
  sensitive   = true
  default     = null
}
variable "talos_node_pool_name" {
  type        = string
  default     = "talos-spot"
  description = "Stable name for the dedicated Talos Spot NodePool and NodeClass."
}
variable "talos_architecture" {
  type    = string
  default = "arm64"
  validation {
    condition     = contains(["arm64", "amd64"], var.talos_architecture)
    error_message = "Talos architecture must be arm64 or amd64."
  }
}
variable "talos_cpu_limit" {
  type        = number
  default     = 4
  description = "Total worker CPU limit; with 2-vCPU instance requirements, each 2 CPU allows one more worker."
  validation {
    condition     = var.talos_cpu_limit >= 2 && var.talos_cpu_limit <= 16
    error_message = "Talos worker CPU limit must be between 2 and 16."
  }
}
variable "talos_memory_limit" {
  type        = string
  default     = "16Gi"
  description = "Total Talos pool memory limit."
}
variable "talos_instance_families" {
  type        = list(string)
  default     = ["c6g", "c7g", "c8g", "m6g", "m7g", "m8g"]
  description = "Diversified non-burstable ARM Spot families."
}
variable "talos_startup_taints" {
  type        = list(object({ key = string, value = optional(string), effect = string }))
  default     = [{ key = "node.cilium.io/agent-not-ready", value = "true", effect = "NoSchedule" }]
  description = "Only taints with a deployed remover. Linkerd CNI taint is deliberately not a Talos default."
}

variable "talos_consolidation_policy" {
  type        = string
  default     = "WhenEmpty"
  description = "Karpenter consolidation policy for the Talos NodePool. WhenEmptyOrUnderutilized also repacks pods to remove underused workers."
  validation {
    condition     = contains(["WhenEmpty", "WhenEmptyOrUnderutilized"], var.talos_consolidation_policy)
    error_message = "talos_consolidation_policy must be WhenEmpty or WhenEmptyOrUnderutilized."
  }
}

variable "talos_taints_enabled" {
  type        = bool
  default     = true
  description = "Apply the spot and arm64 NoSchedule taints to Talos workers. Disable when workers must accept every pod, such as a single-controller cluster."
}

variable "talos_consolidate_after" {
  type        = string
  default     = "60s"
  description = "How long a Talos worker must stay empty or underutilized before Karpenter consolidates it. Raise it to stop repeated repacking after a mass reschedule."
}

variable "talos_drift_disruption_enabled" {
  type        = bool
  default     = true
  description = "Allow voluntary Talos worker replacement for drift. Disable and verify the live zero-Drifted budget before updating bootstrap data when workers must be preserved. Does not block Spot interruption, expiration, repair or manual deletion."
}
