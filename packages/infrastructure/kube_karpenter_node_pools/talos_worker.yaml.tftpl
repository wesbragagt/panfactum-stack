version: v1alpha1
debug: false
persist: true
machine:
  type: worker
  token: ${jsonencode(trust_token)}
  ca:
    crt: ${jsonencode(os_ca)}
    key: ""
  certSANs: []
  features:
    diskQuotaSupport: true
cluster:
  token: ${jsonencode(bootstrap_token)}
---
apiVersion: v1alpha1
kind: DiscoveryServiceConfig
name: default
endpoint: https://discovery.talos.dev/
---
apiVersion: v1alpha1
kind: DiscoveryIdentityConfig
clusterID: ${jsonencode(cluster_id)}
clusterSecret: ${jsonencode(cluster_secret)}
---
apiVersion: v1alpha1
kind: UnattendedInstallConfig
installer:
  image: ${jsonencode(installer_image)}
provisioning:
  diskSelector:
    match: disk.dev_path == "/dev/sda"
  wipe: false
---
apiVersion: v1alpha1
kind: ResolverConfig
hostDNS:
  enabled: true
  forwardKubeDNSToHost: true
---
apiVersion: v1alpha1
kind: VolumeConfig
name: EPHEMERAL
mount:
  secure: true
---
apiVersion: v1alpha1
kind: FilesystemTrimConfig
interval: 168h0m0s
---
apiVersion: v1alpha1
kind: SecurityProfileConfig
workloadIsolation: true
---
apiVersion: v1alpha1
kind: HostnameConfig
auto: stable
---
apiVersion: v1alpha1
kind: KubeClusterConfig
clusterName: ${jsonencode(cluster_name)}
endpoint: ${jsonencode(cluster_endpoint)}
---
apiVersion: v1alpha1
kind: KubeNodeConfig
registerWithFQDN: true
nodeIP: {}
labels:
  node.kubernetes.io/lifecycle: spot
  panfactum.com/class: worker
taints:
  spot: true:NoSchedule
---
apiVersion: v1alpha1
kind: KubeletConfig
image: ${jsonencode("ghcr.io/siderolabs/kubelet:v${kubernetes_version}")}
config: {}
extraArgs:
  cloud-provider: external
  node-ip: 0.0.0.0
defaultRuntimeSeccompProfileEnabled: true
---
apiVersion: v1alpha1
kind: KubeNetworkConfig
dnsDomain: cluster.local
podSubnets: ${jsonencode(pod_subnets)}
serviceSubnets: ${jsonencode(service_subnets)}
---
apiVersion: v1alpha1
kind: KubeAPIServerCAConfig
acceptedCAs: ${jsonencode([kubernetes_ca])}
---
apiVersion: v1alpha1
kind: KubePrismConfig
port: 7445
---
apiVersion: v1alpha1
kind: KubeCredentialProviderConfig
configuration:
  apiVersion: kubelet.config.k8s.io/v1
  kind: CredentialProviderConfig
  providers:
  - apiVersion: credentialprovider.kubelet.k8s.io/v1
    defaultCacheDuration: 12h
    matchImages:
    - '*.dkr.ecr.*.amazonaws.com'
    name: ecr-credential-provider
---
apiVersion: v1alpha1
kind: DHCPv4Config
name: eth0
---
apiVersion: v1alpha1
kind: SysctlConfig
params:
  user.max_user_namespaces: '2147483647'
