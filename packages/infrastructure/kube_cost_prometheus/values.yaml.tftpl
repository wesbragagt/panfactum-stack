serviceAccounts:
  server:
    name: cost-prometheus
# Standalone metrics backend: no Thanos, Grafana, Alertmanager or AWS access.
alertmanager:
  enabled: false
prometheus-pushgateway:
  enabled: false
configmapReload:
  prometheus:
    enabled: false
server:
  fullnameOverride: cost-prometheus-server
  replicaCount: 1
  strategy:
    type: Recreate
  retention: 2d
  retentionSize: 1500MB
  resources:
    requests:
      cpu: 100m
      memory: 512Mi
    limits:
      memory: 1Gi
  service:
    servicePort: 80
    type: ClusterIP
  ingress:
    enabled: false
  persistentVolume:
    enabled: true
    existingClaim: cost-prometheus-data
    storageClass: ${jsonencode(storage_class_name)}
    size: 2Gi
  tolerations:
    - key: node-role.kubernetes.io/control-plane
      operator: Exists
      effect: NoSchedule
  podAnnotations:
    linkerd.io/inject: disabled
kube-state-metrics:
  enabled: true
  fullnameOverride: cost-kube-state-metrics
  resources:
    requests:
      cpu: 10m
      memory: 64Mi
    limits:
      memory: 256Mi
  collectors:
    - pods
    - nodes
    - deployments
    - daemonsets
    - statefulsets
    - replicasets
    - replicationcontrollers
    - jobs
    - cronjobs
    - persistentvolumeclaims
    - persistentvolumes
    - namespaces
    - resourcequotas
    - storageclasses
  metricLabelsAllowlist:
    - nodes=[*]
    - pods=[*]
  tolerations:
    - key: node-role.kubernetes.io/control-plane
      operator: Exists
      effect: NoSchedule
  podAnnotations:
    linkerd.io/inject: disabled
prometheus-node-exporter:
  enabled: true
  fullnameOverride: cost-node-exporter
  service:
    portName: metrics
  resources:
    requests:
      cpu: 10m
      memory: 32Mi
    limits:
      memory: 128Mi
  tolerations:
    - operator: Exists
  podAnnotations:
    linkerd.io/inject: disabled
# Chart29 has generated scrapeConfigs in addition to serverFiles entries.
# Disable every default job to avoid duplicate names and broad annotation scraping.
scrapeConfigs:
  prometheus: { enabled: false }
  kubernetes-api-servers: { enabled: false }
  kubernetes-nodes: { enabled: false }
  kubernetes-nodes-cadvisor: { enabled: false }
  kubernetes-pods: { enabled: false }
  kubernetes-pods-slow: { enabled: false }
  kubernetes-service-endpoints: { enabled: false }
  kubernetes-service-endpoints-slow: { enabled: false }
  kubernetes-services: { enabled: false }
  prometheus-pushgateway: { enabled: false }
# Replace broad chart auto-discovery with only the metrics needed by costs.
serverFiles:
  prometheus.yml:
    rule_files: []
    scrape_configs:
      - job_name: prometheus
        honor_labels: true
        static_configs:
          - targets: [localhost:9090]
      - job_name: kubernetes-nodes
        honor_labels: true
        scheme: https
        kubernetes_sd_configs:
          - role: node
        bearer_token_file: /var/run/secrets/kubernetes.io/serviceaccount/token
        tls_config:
          ca_file: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
        relabel_configs:
          - target_label: __address__
            replacement: kubernetes.default.svc:443
          - source_labels: [__meta_kubernetes_node_name]
            target_label: __metrics_path__
            replacement: /api/v1/nodes/$1/proxy/metrics
          - source_labels: [__meta_kubernetes_node_name]
            target_label: instance
          - source_labels: [__meta_kubernetes_node_name]
            target_label: node
          - action: labelmap
            regex: __meta_kubernetes_node_label_(.+)
      - job_name: kubernetes-cadvisor
        honor_labels: true
        scheme: https
        kubernetes_sd_configs:
          - role: node
        bearer_token_file: /var/run/secrets/kubernetes.io/serviceaccount/token
        tls_config:
          ca_file: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
        relabel_configs:
          - target_label: __address__
            replacement: kubernetes.default.svc:443
          - source_labels: [__meta_kubernetes_node_name]
            target_label: __metrics_path__
            replacement: /api/v1/nodes/$1/proxy/metrics/cadvisor
          - source_labels: [__meta_kubernetes_node_name]
            target_label: instance
          - source_labels: [__meta_kubernetes_node_name]
            target_label: node
      - job_name: kube-state-metrics
        honor_labels: true
        static_configs:
          - targets: [cost-kube-state-metrics.${namespace}.svc.cluster.local:8080]
      - job_name: node-exporter
        honor_labels: true
        kubernetes_sd_configs:
          - role: endpointslice
            namespaces:
              names: [${jsonencode(namespace)}]
        relabel_configs:
          - source_labels: [__meta_kubernetes_service_name]
            regex: cost-node-exporter
            action: keep
          - source_labels: [__meta_kubernetes_endpointslice_port_name]
            regex: metrics
            action: keep
          - source_labels: [__meta_kubernetes_endpointslice_endpoint_node_name]
            target_label: instance
          - source_labels: [__meta_kubernetes_endpointslice_endpoint_node_name]
            target_label: node
      - job_name: opencost
        honor_labels: true
        scrape_interval: 1m
        scrape_timeout: 10s
        static_configs:
          - targets: [open-cost.open-cost.svc.cluster.local:9003]
