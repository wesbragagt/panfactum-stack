#!/usr/bin/env bash
set -euo pipefail
umask 077

# NOTE: EC2 starts cloud-init before OpenTofu can attach the persistent data volume.
device="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_${volume_id}"
for ((attempt = 1; ; attempt++)); do
  [[ -b "$device" ]] && break
  ((attempt < 90)) || exit 1
  sleep 10
done
mkdir -p /var/lib/headscale
if ! blkid "$device" >/dev/null; then
  mkfs.ext4 "$device"
fi
printf '%s /var/lib/headscale ext4 defaults,nofail 0 2\n' "$device" >> /etc/fstab
mount /var/lib/headscale

getent group headscale >/dev/null || groupadd --system headscale
id headscale >/dev/null 2>&1 || useradd --system --gid headscale --home-dir /var/lib/headscale --shell /sbin/nologin headscale
chown -R headscale:headscale /var/lib/headscale
install -d -m 0750 -o root -g headscale /etc/headscale
curl --fail --silent --show-error --location --retry 8 --retry-all-errors \
  https://github.com/juanfont/headscale/releases/download/v0.28.0/headscale_0.28.0_linux_arm64 \
  -o /usr/local/bin/headscale
echo '0b8d8739b8a243b01afdab04359ebec9e8b16e13d3e7eb4ba71c7c1173c18345  /usr/local/bin/headscale' | sha256sum -c -
chmod 0755 /usr/local/bin/headscale
cat >/etc/headscale/config.json <<'CONFIG'
${config}
CONFIG
cat >/etc/headscale/policy.json <<'POLICY'
${policy}
POLICY
chgrp headscale /etc/headscale/*.json
chmod 0640 /etc/headscale/*.json

cat >/etc/systemd/system/headscale.service <<'UNIT'
[Unit]
Description=Headscale
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/headscale

[Service]
User=headscale
Group=headscale
RuntimeDirectory=headscale
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ExecStart=/usr/local/bin/headscale --config /etc/headscale/config.json serve
Restart=on-failure

[Install]
WantedBy=multi-user.target
UNIT

cat >/usr/local/sbin/headscale-enrollment <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail
umask 077
request=$(mktemp /run/headscale-enrollment.XXXXXX)
trap 'rm -f "$request"' EXIT
/usr/local/bin/headscale --config /etc/headscale/config.json preauthkeys create --reusable --ephemeral --expiration 168h --tags tag:subnet-router -o json |
  python3 -c '
import json
import sys

key = json.load(sys.stdin)["key"]
if not key:
    sys.exit("Headscale returned an empty enrollment key")
json.dump({"Name": sys.argv[1], "Type": "SecureString", "Overwrite": True, "Value": key}, sys.stdout)
' '${parameter}' > "$request"
aws ssm put-parameter --region '${region}' --cli-input-json "file://$request" >/dev/null
SCRIPT
chmod 0700 /usr/local/sbin/headscale-enrollment

cat >/etc/systemd/system/headscale-enrollment.service <<'UNIT'
[Unit]
Description=Refresh the Headscale router enrollment key
Requires=headscale.service
After=headscale.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/headscale-enrollment
Restart=on-failure
RestartSec=10s
UNIT

cat >/etc/systemd/system/headscale-enrollment.timer <<'UNIT'
[Unit]
Description=Refresh the Headscale enrollment key before expiry

[Timer]
OnBootSec=5s
OnUnitActiveSec=1d

[Install]
WantedBy=timers.target
UNIT

systemctl daemon-reload
systemctl enable --now headscale.service headscale-enrollment.timer
