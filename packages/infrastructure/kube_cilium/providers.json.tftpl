${jsonencode({
  helm_provider = {
    path      = "helm.tf"
    if_exists = "overwrite_terragrunt"
    contents  = <<-HCL
      provider "helm" {
        kubernetes = {
          host           = ${jsonencode(kube_api_server)}
          config_context = ${jsonencode(kube_config_context)}
        }
      }
    HCL
  }
  kubernetes_provider = {
    path      = "kubernetes.tf"
    if_exists = "overwrite_terragrunt"
    contents  = <<-HCL
      provider "kubernetes" {
        host           = ${jsonencode(kube_api_server)}
        config_context = ${jsonencode(kube_config_context)}
      }
    HCL
  }
  kubectl_provider = {
    path      = "kubectl.tf"
    if_exists = "overwrite_terragrunt"
    contents  = <<-HCL
      provider "kubectl" {
        host           = ${jsonencode(kube_api_server)}
        config_context = ${jsonencode(kube_config_context)}
      }
    HCL
  }
})}
